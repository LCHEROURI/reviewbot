{
  "name": "reviewbot",
  "version": "1.0.0",
  "description": "AI-powered GitHub App that posts inline pull request review comments.",
  "main": "dist/index.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/ api/ --ext .ts",
    "lint:fix": "eslint src/ api/ --ext .ts --fix",
    "vercel-build": "tsc && cp dashboard.html dist/"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.57.0",
    "@octokit/app": "^14.1.0",
    "@octokit/rest": "^20.1.2",
    "@octokit/webhooks": "^12.0.4",
    "@vercel/node": "^3.2.0",
    "dotenv": "^16.4.7",
    "express": "^4.21.2"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.7",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^8.57.0",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.7.3"
  }
}
