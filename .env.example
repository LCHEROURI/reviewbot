# GitHub App ID (found on your GitHub App settings page)
GITHUB_APP_ID=

# GitHub App private key (the entire .pem file contents,
# with actual newlines replaced by \n)
GITHUB_PRIVATE_KEY=

# GitHub App webhook secret (the secret you set when creating the app)
GITHUB_WEBHOOK_SECRET=

# Anthropic API key
ANTHROPIC_API_KEY=

# Port for the Express server (local dev only)
PORT=3000
